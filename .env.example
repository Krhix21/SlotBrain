# ============================================================
# Groq (IA)
# ============================================================
GROQ_API_KEY=

# ============================================================
# Meta WhatsApp Cloud API
# ============================================================
# Phone Number ID del número que responde. Se usa como respaldo
# cuando el número no trae un token propio en META_TOKENS_JSON.
META_PHONE_NUMBER_ID=

# Access token (temporal o de usuario del sistema).
# Fallback para el número principal.
META_WHATSAPP_TOKEN=

# Un token por número, cuando una empresa trae su propio número.
# Formato: {"<phone_number_id>":"<token>","<otro_id>":"<otro_token>"}
# OJO: el token NUNCA va en la base de datos, solo en este archivo
# (SUPABASE_KEY es una anon key pública y cualquiera puede leer las tablas).
META_TOKENS_JSON=

# Cadena que tú eliges. Debe coincidir con el "Verify token" que
# configuras en Meta → WhatsApp → Webhooks.
META_VERIFY_TOKEN=

# App Secret (Meta → App Settings → Basic). Se usa para validar
# la firma X-Hub-Signature-256 de cada POST entrante.
META_APP_SECRET=

# ============================================================
# Google OAuth (Calendar)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe ser IDÉNTICO al que registraste en Google Cloud Console.
# Local: http://localhost:3000/auth/google/callback
# Producción: https://tu-app.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=

# Secreto para firmar los enlaces de vinculación de Google Calendar.
# Si lo dejas vacío se usa GOOGLE_CLIENT_SECRET, pero es mejor darle uno
# propio y rotable. Si no hay ninguno de los dos, el panel NO genera
# enlaces: es preferible bloquearlo que firmarlos sin protección.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_ENLACE=

# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=
SUPABASE_KEY=

# ============================================================
# Servidor
# ============================================================
PORT=3000

# Opcional. La URL pública del servicio, sin barra final.
# El panel la usa para armar el enlace de vinculación de Google Calendar.
# Si la dejas vacía, se deduce de la petición entrante.
# Local: http://localhost:3000
# Producción: https://tu-app.onrender.com
PUBLIC_URL=

# ============================================================
# Panel de administración (/admin.html)
# ============================================================
ADMIN_USER=
ADMIN_PASSWORD=
